    "version": "0.2.0",
    "configurations": [
        {
            "name": "FC-OpenOCD-Debug-CM7",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/flight_controller/CM7/build/ulysses-fc_CM7.elf",
            "loadFiles": [
                "${workspaceFolder}/flight_controller/CM7/build/ulysses-fc_CM7.elf",
                "${workspaceFolder}/flight_controller/CM4/build/ulysses-fc_CM4.elf"
            ],
            "symbolFiles": [
                "${workspaceFolder}/flight_controller/CM7/build/ulysses-fc_CM7.elf",
                "${workspaceFolder}/flight_controller/CM4/build/ulysses-fc_CM4.elf"
            ],
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "${env:STM32_OPENOCD_PATH}",
            "configFiles": [
                "interface/stlink-dap.cfg",
                "board/flight_controller.cfg"
            ],
            "svdFile": "${workspaceFolder}/platform/svd/STM32H747_CM7.svd",
            "searchDir": [
                "${workspaceFolder}/platform/tcl/",
                "${env:STM32_OPENOCD_SCRIPTS_PATH}"
            ],
            "showDevDebugOutput": "vscode",
            "openOCDPreConfigLaunchCommands": [
                "set AP_NUM 0"
            ],
            "preLaunchTask": "fc-build-debug"
        },
        {
            "name": "FC-OpenOCD-Debug-CM4",
