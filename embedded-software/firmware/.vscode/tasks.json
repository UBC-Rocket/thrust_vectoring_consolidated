{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "fc-build-debug",
			"preset": "Debug",
			"command": "build",
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"options": {
				"cwd": "${workspaceFolder}/flight_controller"
			},
			"dependsOn": [
				"fc-configure-debug"
			]
		},
		{
			"type": "cmake",
			"label": "fc-configure-debug",
			"command": "configure",
			"preset": "Debug",
			"group": "none",
			"hide": true,
			"options": {
				"cwd": "${workspaceFolder}/flight_controller"
			}
		},
		{
			"type": "cmake",
			"label": "fc-build-release",
			"preset": "Release",
			"command": "build",
			"group": "build",
			"problemMatcher": [
				"$gcc"
			],
			"options": {
				"cwd": "${workspaceFolder}/flight_controller"
			},
			"dependsOn": [
				"fc-configure-release"
			]
		},
		{
			"type": "cmake",
			"label": "fc-configure-release",
			"command": "configure",
			"preset": "Release",
			"group": "none",
			"hide": true,
			"options": {
				"cwd": "${workspaceFolder}/flight_controller"
			}
		},
	]
}